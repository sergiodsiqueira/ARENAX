# Diretório absoluto ou relativo onde a ARENAX guarda buffers, Replays e heartbeats.
# No Windows, use barras normais, por exemplo: D:/ARENAX/media
ARENAX_MEDIA_HOST_PATH=./media
# Preenchido automaticamente pelo instalador do Agente Local.
ARENAX_HOST_AGENT_SECRET=

# Troque estes valores durante a instalação.
ARENAX_LIVE_PATH_SECRET=change-me
ARENAX_WEBRTC_HOST=127.0.0.1
